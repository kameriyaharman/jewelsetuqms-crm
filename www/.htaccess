# JEWELSETU — Apache config for Linux shared hosting (cPanel / Hostinger) and the Railway Docker image
#   /       public website (index.php adds SEO tags to the React site)     /admin  website CMS
#   /erp    Q-TRACK ERP (React single-page app in erp/)                     /api    PHP JSON API
Options -Indexes
DirectoryIndex index.php index.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  # If installed in a sub-folder, set e.g.:  RewriteBase /qtrack/   (and build with VITE_BASE=/qtrack/)
  # PHP code, uploads and database config are never served directly
  RewriteRule ^server(/|$) - [F,L]
  # JSON API
  RewriteRule ^api/index\.php$ - [L]
  RewriteRule ^api(/.*)?$ api/index.php [QSA,L]
  # Q-TRACK ERP: everything under /erp that is not a real file -> erp/index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^erp(/.*)?$ erp/index.html [L]
  # Website, /admin, sitemap.xml, robots.txt and old ERP links -> index.php
  RewriteRule ^index\.php$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [QSA,L]
</IfModule>
<IfModule mod_php.c>
  php_value upload_max_filesize 32M
  php_value post_max_size 40M
  php_value memory_limit 256M
  php_value max_execution_time 120
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|png|jpg|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
